{
  "appId": "io.github.rayanedr.kivou",
  "productName": "Kivou",
  "electronVersion": "43.4.0",
  "directories": {
    "output": "../../releases/portable-v0.3.0",
    "buildResources": "."
  },
  "compression": "normal",
  "win": {
    "target": [
      "portable"
    ],
    "icon": "icon.ico",
    "signAndEditExecutable": false
  },
  "portable": {
    "artifactName": "Kivou.exe",
    "requestExecutionLevel": "user",
    "unpackDirName": false,
    "useZip": true
  }
}
